# --- IMAP (Gmail con App Password) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@gmail.com
# Generada en https://myaccount.google.com/apppasswords (requiere 2FA activo)
IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_MAILBOX=INBOX
IMAP_PROCESSED_LABEL=Procesado-BCP

# --- Filtros de búsqueda ---
BCP_SENDER=notificacionesbcp.com.pe
BCP_SUBJECT_HINTS=Realizaste un consumo,CONSTANCIA DE PAGO DE SERVICIO

# --- Estrategia de Almacenamiento (SOLID / Factory) ---
# Opciones:
# - auto: Detecta si corre en GitHub Actions (usa Parquet Cloud) o en PC local (usa SQL Server con fallback)
# - mssql: Forzar persistencia en SQL Server
# - parquet: Forzar persistencia en Parquet / Data Lake
# - both: Guardar simultáneamente en SQL Server y en Parquet / R2
STORAGE_SINK=auto

# Ruta para Data Lake Parquet local (particionado Hive year=YYYY/month=MM/)
PARQUET_PATH=./data/datalake

# --- Base de datos SQL Server (Destino relacional / Dashboards) ---
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=GastosBCP
MSSQL_USER=sa
MSSQL_SA_PASSWORD=TuPasswordSeguro123!
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Cloudflare R2 / S3 (Opcional - Data Lake en la Nube Gratis) ---
# Dejar vacío si solo se desea Data Lake Parquet local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gastos-lakehouse

# --- Checkpoint (fallback si no se usa label de IMAP) ---
CHECKPOINT_PATH=./data/checkpoint.json

# --- Zona horaria ---
TIMEZONE=America/Lima
