FROM apache/airflow:2.9.3-python3.11

# Driver ODBC de Microsoft para SQL Server (lo necesita pyodbc en runtime,
# via requirements.txt, para que SqlServerGastoRepository pueda conectar).
# Requiere USER root para apt-get; se vuelve a "airflow" antes de pip
# install porque el resto de la imagen (y Airflow en general) no debe
# correr como root. La version de Debian se detecta en build-time en vez
# de hardcodearla, para no romper si la imagen base de apache/airflow
# cambia de version de Debian en el futuro.
USER root
# Metodo manual (gpg + sources.list explicito) en vez del paquete
# "packages-microsoft-prod.deb" -- ese paquete tiene un bug conocido en
# Debian 12/bookworm que deja dos entradas de repo con "Signed-By"
# distinto para la misma URL ("Conflicting values set for option
# Signed-By"), y `apt-get update` falla. El metodo manual evita el
# paquete conflictivo por completo.
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && DEBIAN_VERSION=$(. /etc/os-release && echo "$VERSION_ID") \
    && DEBIAN_CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME") \
    && echo "deb [arch=amd64,armhf,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/${DEBIAN_VERSION}/prod ${DEBIAN_CODENAME} main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
USER airflow

# requirements.txt trae apache-airflow comentado (ya esta en la base image)
# y pytest (innecesario en runtime, pero inofensivo instalarlo).
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
